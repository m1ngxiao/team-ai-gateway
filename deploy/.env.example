# Copy to deploy/.env, chmod 600, then edit. Never commit the local file.
# Origins are compiled into the frontend; changes require rebuilding gateway.
PUBLIC_API_ORIGIN=http://127.0.0.1:48760
PUBLIC_ADMIN_ORIGIN=http://127.0.0.1:48761
PUBLIC_STATS_ORIGIN=http://127.0.0.1:48763

# Host ports always bind to 127.0.0.1. Update origins if changing ports locally.
GATEWAY_PORT=48760
ADMIN_PORT=48761
STATS_PORT=48763
TZ=UTC

# Empty means direct access. A proxy must be reachable from Docker's bridge.
# HTTP_PROXY/HTTPS_PROXY apply to builds; UPSTREAM_PROXY applies to runtime.
UPSTREAM_PROXY=
HTTP_PROXY=
HTTPS_PROXY=

GATEWAY_CPUS=4.0
GATEWAY_MEMORY=8g
HTTP_WORKERS=8
STREAM_WORKERS=8
TOKIO_WORKER_THREADS=4
RAYON_NUM_THREADS=4
CARGO_BUILD_JOBS=4
DYNAMIC_OVERLOAD_ENABLED=true
DYNAMIC_RECOVERY_LIMIT=8
# Claude Code compatibility. Empty classifier model reuses the requested model.
CLAUDE_SAFEGUARDS_EMULATION_ENABLED=true
CLAUDE_SAFEGUARDS_CLASSIFIER_MODEL=
CLAUDE_CONTEXT_MANAGEMENT_ENABLED=true
# Empty compact summary model reuses the requested model.
CLAUDE_COMPACT_SUMMARY_MODEL=
CLAUDE_COMPACT_SUMMARY_MAX_TOKENS=4096
# Artifact links use PUBLIC_API_ORIGIN unless overridden here.
# PUBLIC_API_ORIGIN=https://api.example.com
# Gateway client-version metadata check; model additions use the separate timer.
CODEX_LATEST_SYNC_INTERVAL_SECS=86400
COLLECTOR_CPUS=0.5
COLLECTOR_MEMORY=256m
DASHBOARD_CPUS=1.0
DASHBOARD_MEMORY=256m

# Optional split administration UI (deploy/compose.ui-refresh.yml).
# TEAM_GATEWAY_IMAGE=team-ai-gateway:latest
# TEAM_GATEWAY_DATA_DIR=./data/gateway
# TEAM_GATEWAY_SERVICE_ADDR=codexmanager:48760
ADMIN_WEB_BIND_ADDR=127.0.0.1
ADMIN_WEB_PORT=48766

# Optional provenance label for a build from a checkout or source archive.
SOURCE_REVISION=unknown

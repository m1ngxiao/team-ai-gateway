# Copy to deploy/.env, chmod 600, then edit. Never commit the local file.
# Origins are compiled into the frontend; changes require rebuilding gateway.
PUBLIC_API_ORIGIN=http://127.0.0.1:48760
PUBLIC_ADMIN_ORIGIN=http://127.0.0.1:48761
PUBLIC_STATS_ORIGIN=http://127.0.0.1:48763

# Host ports always bind to 127.0.0.1. Update origins if changing ports locally.
GATEWAY_PORT=48760
ADMIN_PORT=48761
STATS_PORT=48763
TZ=UTC

# Empty means direct access. A proxy must be reachable from Docker's bridge.
# HTTP_PROXY/HTTPS_PROXY apply to builds; UPSTREAM_PROXY applies to runtime.
UPSTREAM_PROXY=
HTTP_PROXY=
HTTPS_PROXY=

GATEWAY_CPUS=4.0
GATEWAY_MEMORY=8g
HTTP_WORKERS=8
STREAM_WORKERS=8
TOKIO_WORKER_THREADS=4
RAYON_NUM_THREADS=4
CARGO_BUILD_JOBS=4
DYNAMIC_OVERLOAD_ENABLED=true
COLLECTOR_CPUS=0.5
COLLECTOR_MEMORY=256m
DASHBOARD_CPUS=1.0
DASHBOARD_MEMORY=256m

# Optional provenance label for a build from a checkout or source archive.
SOURCE_REVISION=unknown

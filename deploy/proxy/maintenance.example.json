{
  "version": 1,
  "subscription_url_file": "private/subscription.url",
  "source_file": "private/source.yaml",
  "state_dir": "private/maintenance-state",
  "download_proxy": "http://127.0.0.1:7890",
  "node_identity": "name-hostname",
  "targets": [
    {
      "name": "personal",
      "directory": "private/personal",
      "binary": "mihomo",
      "config_file": "config.yaml",
      "selections_file": "selection.json"
    },
    {
      "name": "business",
      "directory": "private/business",
      "binary": "mihomo",
      "config_file": "config.yaml",
      "selections_file": "selectors.json",
      "us_auto": {
        "group": "US Auto",
        "selector": "Proxy",
        "replaced_groups": ["Auto"],
        "manifest_file": "private/us-node-verification.json",
        "health_check_url": "https://www.gstatic.com/generate_204",
        "interval": 180,
        "tolerance": 30,
        "timeout": 5000,
        "expected_status": 204,
        "egress_proxy": "http://127.0.0.1:7890",
        "egress_check_url": "https://www.cloudflare.com/cdn-cgi/trace"
      }
    }
  ]
}
